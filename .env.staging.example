# ─────────────────────────────────────────────────────────────────────────────
# Homologação do Ide Fazei — copie para ".env.staging" na VPS e preencha.
# NUNCA coloque valores reais de produção aqui, e nunca commite o .env.staging.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco (MySQL do próprio compose) ─────────────────────────────────────────
# Use só letras e números nas senhas: elas entram numa URL de conexão.
STAGING_DB_ROOT_PASSWORD=troque-por-uma-senha-forte
STAGING_DB_NAME=idefazei_staging
STAGING_DB_USER=idefazei
STAGING_DB_PASSWORD=troque-por-outra-senha-forte

# ── Portas locais (o proxy reverso aponta para STAGING_APP_PORT) ─────────────
STAGING_APP_PORT=3100
STAGING_DB_PORT=3307

# ── Aplicação ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32  (diferente da produção!)
JWT_SECRET=
INTERNAL_JOBS_TOKEN=
# Código usado uma única vez para criar o Super Admin na homologação
SUPER_ADMIN_SETUP_TOKEN=

# Endereço público da homologação. NÃO use um endereço que contenha
# "idefazei.com.br": o código monta links de e-mail com esse domínio.
PUBLIC_APP_URL=https://homolog.exemplo.com

VITE_APP_ID=
VITE_APP_TITLE=Ide Fazei (homologação)

# Autenticação/serviços externos herdados do projeto. Deixe vazio se não usa.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── E-mail: DESLIGADO na homologação ─────────────────────────────────────────
# Evita mandar mensagens de teste para pessoas reais.
PASSWORD_RESET_EMAIL_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# ── Pagamentos: use SOMENTE chaves de TESTE do Stripe (sk_test_...) ──────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Mídia (Cloudinary): use uma conta/pasta de teste, separada da produção ───
MEDIA_PROVIDER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Push e alertas: desligados por padrão ────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:homologacao@exemplo.com
SECURITY_ALERT_CHANNEL=disabled
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_TOKEN=
